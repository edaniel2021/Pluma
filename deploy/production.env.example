# PRODUCTION .env - for the later deployment alongside smarthomecare (see
# deploy/staging.env.example for the current staging box, which is a
# different environment on a different server with a different existing
# stack to avoid colliding with).
#
# Not a full .env, just the values that change. Everything else (DB creds,
# provider client IDs, etc.) follows .env.example as usual.
#
# Architecture: Pluma runs as its own docker-compose stack (this repo's
# compose.yaml) alongside smarthomecare's separate stack on the same VM.
# smarthomecare's own Caddy instance already owns host ports 80/443 - Pluma
# does NOT run its own reverse proxy. Instead, Pluma's app/Reverb ports are
# pinned to fixed host ports (8090/8091) that are internal-only (reachable
# from the host/Docker bridge, NOT opened to the public internet), and a
# second site block gets added to smarthomecare's existing Caddyfile
# (see deploy/caddy-site-block.txt) that reverse-proxies the new hostname
# to those ports via `host.docker.internal`.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://pluma.alessahomecare.com

# Must be set explicitly before the very first `docker compose up` on the
# server - compose.yaml's ports: section falls back to binding host port 80
# by default if APP_PORT is unset, which would collide with smarthomecare's
# Caddy. Do NOT open these in ufw/the cloud security group for public
# access - only Caddy (via host.docker.internal) needs to reach them.
APP_PORT=8090
REVERB_SERVER_PORT=8091

# What the BROWSER connects to - goes through smarthomecare's Caddy on 443,
# which reverse-proxies to REVERB_SERVER_PORT internally (see
# deploy/caddy-site-block.txt). This is the main gotcha: these must be the
# public domain/port/scheme, NOT the internal bind port, or the websocket
# handshake fails from outside the server.
REVERB_HOST="pluma.alessahomecare.com"
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# OAuth callback URLs derive from APP_URL automatically (see
# config/services.php), so X_REDIRECT_URI etc. don't need separate
# overrides - but you DO need to add the production callback URL as a
# second registered redirect URI in each platform's developer portal
# (X, LinkedIn, Meta, Google), alongside the localhost one you already
# added for local testing. Same OAuth app, two registered callback URLs.
