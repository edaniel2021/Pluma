# Staging .env differences from local dev - not a full .env, just the
# values that change. Everything else (DB creds, provider client IDs, etc.)
# follows .env.example as usual.
#
# Architecture: this staging box already runs a separate "marketing"
# Sail/Laravel stack (URL shortener + QR codes) fronted by a native Apache
# install on 80/443. Pluma runs as its own, independent docker-compose
# stack alongside it - NOT sharing the marketing stack's containers or
# network. Apache gets a second VirtualHost (deploy/apache-vhost.conf)
# that reverse-proxies to Pluma's fixed internal ports.

APP_ENV=staging
APP_DEBUG=false
APP_URL=https://pluma-staging.1hundredbytes.com

# Must be set explicitly before the very first `docker compose up` here -
# compose.yaml's ports: section falls back to binding host port 80 by
# default if APP_PORT is unset, which would collide with Apache. Do NOT
# open these in the EC2 security group for public access - only Apache
# (via 127.0.0.1, see deploy/apache-vhost.conf) needs to reach them.
APP_PORT=8090
REVERB_SERVER_PORT=8091

# The marketing stack on this box already occupies 5173 (Vite) and 6379
# (Redis) by default - these avoid colliding with it. FORWARD_DB_PORT
# doesn't strictly need to change (marketing uses MySQL on 13306, not
# Postgres), but costs nothing to set anyway for consistency with local
# dev's same-purpose offsets.
VITE_PORT=5174
FORWARD_REDIS_PORT=6380
FORWARD_DB_PORT=5433

# What the BROWSER connects to - goes through this box's Apache on 443,
# which reverse-proxies to REVERB_SERVER_PORT internally (see
# deploy/apache-vhost.conf). This is the main gotcha: these must be the
# public domain/port/scheme, NOT the internal bind port, or the websocket
# handshake fails from outside the server.
REVERB_HOST="pluma-staging.1hundredbytes.com"
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# OAuth callback URLs derive from APP_URL automatically (see
# config/services.php) - add this staging callback URL as an additional
# registered redirect URI in each platform's developer portal (X,
# LinkedIn, Meta, Google), alongside the localhost one already added for
# local testing. Same OAuth app, multiple registered callback URLs.
