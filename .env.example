APP_NAME=Pluma
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_PORT=8090
VITE_PORT=5174
FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6380
FORWARD_MAILPIT_PORT=1026
FORWARD_MAILPIT_DASHBOARD_PORT=8026

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Lets php artisan serve (what the laravel.test container runs) handle
# several requests concurrently instead of one at a time - without it, a
# handful of overlapping requests (a Livewire wire:poll tick, a
# broadcasting-auth call, an asset fetch) queue up and wait for each
# other. Only takes effect via compose.yaml's environment block below,
# NOT just being set here - PHP's built-in server reads this at its own
# native startup, before Laravel's own .env parsing ever runs.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

REGISTRATION_DISABLED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

SENTRY_LARAVEL_DSN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ULTIMATE=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/integrations/linkedin/callback"

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI="${APP_URL}/integrations/x/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/integrations/facebook/callback"

# Instagram publishing uses the same Meta app as Facebook above - only set
# these if you want a separate app for it.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI="${APP_URL}/integrations/instagram/callback"

# YouTube uploads use the same Google Cloud OAuth app as GOOGLE_CLIENT_ID
# above by default - only set these if you want a separate project (e.g.
# for its own YouTube Data API quota).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI="${APP_URL}/integrations/youtube/callback"

# Google Search Console (see app/Domain/Seo) - same "reuse GOOGLE_CLIENT_ID
# by default" pattern as YOUTUBE_* above. Enable the Search Console API on
# whichever Google Cloud project these credentials belong to.
SEARCH_CONSOLE_CLIENT_ID=
SEARCH_CONSOLE_CLIENT_SECRET=
SEARCH_CONSOLE_REDIRECT_URI="${APP_URL}/seo/search-console/callback"

# PageSpeed Insights API (see App\Domain\Seo\Support\PageSpeedClient) - a
# plain API key, not OAuth. Enable the PageSpeed Insights API on your
# Google Cloud project and generate a key for it.
PAGESPEED_API_KEY=

# Powers the AI agent chat (text + tool-calling: listing channels, generating
# images, scheduling posts) - see app/Domain/Agents. AI_CHAT_PROVIDER picks
# which service backs the tool-calling loop ('openai' or 'gemini') - only
# that provider's API key below actually needs to be set.
AI_CHAT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# Only used when AI_CHAT_PROVIDER=gemini. Get a key from
# https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Image-generation priority (see GenerateImageTool): FAL first if FAL_KEY
# is set below (generally cheaper/faster), then Gemini's own native image
# generation if AI_CHAT_PROVIDER=gemini (so a Gemini-centric setup doesn't
# also need an OpenAI/FAL key), then OpenAI's Images API as the final
# fallback.
FAL_KEY=

# Powers real-time streaming for the AI chat (App\Domain\Agents) instead of
# wire:poll - run `sail artisan reverb:start` separately (like Horizon, this
# isn't auto-started). Port shifted off Reverb's 8080 default to avoid
# clashing with other local services. REVERB_SERVER_PORT (what reverb:start
# binds to) must match REVERB_PORT (what clients connect to) since there's
# no reverse proxy translating between them in local dev.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8091
REVERB_SERVER_PORT=8091
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"
